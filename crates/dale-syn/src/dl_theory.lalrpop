use std::str::FromStr;

use lalrpop_util::ParseError;

use dale_util::symbol::Symbol;

use crate::{raw_theory::*, ParserCtx};

grammar(ctx: &mut ParserCtx);

// Whitespace and `// line comments` are skipped; all other tokens keep lalrpop's default
// priorities (fixed strings before regular expressions).
match {
    r"\s*" => {},
    r"//[^\n]*" => {},
} else {
    _
}

pub File: File = {
    <items:ModuleItem*> => File { id: ctx.id(), items }
}

pub ModuleItem: ModuleItem = {
    <t:Theory> => ModuleItem::Theory(t),
    <p:Problem> => ModuleItem::Theory(p),
    <m:Module> => ModuleItem::Module(m),
}

// `\problem { \use ...; ante ==> succ }`: the sequent to prove. A problem declares nothing; it
// only uses theories. It is represented as a theory (`Theory::problem`) whose last item is the
// sequent, so that `\use` and name resolution work as in theories. At most one per input.
pub Problem: Theory = {
    <start: @L> "\\problem" "{" <mut items:ProblemUse*> <sstart: @L> <seq:ProblemSeq> <send: @R> "}" <end: @R> => {
        items.push(Item { id: ctx.id(), span: ctx.span(sstart, send), kind: ItemKind::Problem(seq) });
        Theory {
            id: ctx.id(),
            name: Spanned::new(ctx.intern("\\problem"), ctx.span(start, end)),
            items,
            problem: true,
        }
    }
}

ProblemUse: Item = <start: @L> "\\use" <u:UseTree> ";" <end: @R> =>
    Item { id: ctx.id(), span: ctx.span(start, end), kind: ItemKind::Use(u) };

ProblemSeq: Seq = <ante:Comma<ProblemTerm>> "==>" <succ:Comma<ProblemTerm>> =>
    Seq { id: ctx.id(), ante, succ };

// Terms of problems: with explicit generic arguments (`all<int>(..)`) and number literals for
// meta arguments (`var(0)`, a de Bruijn index).
ProblemTerm: Term = {
    <start: @L> <p:Path> "(" <args:Comma<ProblemTerm>> ")" <end: @R> => Term {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: TermKind::Call(p, args)
    },
    <start: @L> <p:Path> "<" <g:Comma<GenericArg>> ">" "(" <args:Comma<ProblemTerm>> ")" <end: @R> => Term {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: TermKind::ParametricCall(p, g, args)
    },
    <start: @L> <p:Path> "<" <g:Comma<GenericArg>> ">" <end: @R> => Term {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: TermKind::ParametricPath(p, g)
    },
    <start: @L> <p:Path> <end: @R> => Term {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: TermKind::Path(p)
    },
    <start: @L> <n:Int> <end: @R> => Term {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: TermKind::Num(n as u64)
    },
}

// `\module Name;` is loaded from the file `Name.theokey`; `\module Name { ... }` is inline.
pub Module: Module = {
    <start: @L> "\\module" <name:Ident> ";" <end: @R> => Module {
        id: ctx.id(),
        name,
        span: ctx.span(start, end),
        external: true,
        items: Vec::new(),
    },
    <start: @L> "\\module" <name:Ident> "{" <items:ModuleItem*> "}" <end: @R> => Module {
        id: ctx.id(),
        name,
        span: ctx.span(start, end),
        external: false,
        items,
    },
}

pub Theory: Theory = {
    "\\theory" <name:Ident> "{" <items:Item*> "}" => 
    Theory {id: ctx.id(), name, items, problem: false}
};

pub Ident: Spanned<Symbol> = {
    <start: @L> <s:r"[a-zA-Z][a-zA-Z0-9_]*"> <end: @R> => Spanned::new(ctx.intern(s), ctx.span(start, end)),
    <start: @L> <s:r"_[a-zA-Z0-9]+"> <end: @R> => Spanned::new(ctx.intern(s), ctx.span(start, end)),
}

Item: Item = <start: @L> <k:ItemKind> <end: @R> => Item {id: ctx.id(), span: ctx.span(start, end), kind: k};

ItemKind: ItemKind = {
    "\\use" <UseTree> ";" => ItemKind::Use(<>),
    "\\operators" "{" <ops:FunctionDecl*> "}" => ItemKind::Operators(ops),
    "\\sorts" "{" <node:SortDecl*> "}" => ItemKind::Sorts(node),
    "\\datatypes" "{" "}" => ItemKind::DataTypes(DataTypeDecls {}),
    "\\functions" "{" <node:FunctionDecl*> "}" => ItemKind::Functions(node),
    "\\predicates" "{" <node:PredicateDecl*> "}" => ItemKind::Predicates(node),
    "\\axioms" "{" "}" => ItemKind::Axioms(),
    "\\rules" "{" <rules:Rule*> "}" => ItemKind::Rules(rules),
    "\\rulesets" "{" <rs:RuleSetDecl*> "}" => ItemKind::RuleSets(rs),
    "\\costs" "{" <cs:CostItem*> "}" => ItemKind::Costs(cs)
}

UseTree: UseTree = {
    <start: @L> <prefix:Path> "::*" <end: @R> => UseTree {
        prefix,
        kind: UseTreeKind::Glob,
        span: ctx.span(start, end)
    },
    <start: @L> <prefix:Path> <end: @R> => UseTree {
        prefix,
        kind: UseTreeKind::Simple(None),
        span: ctx.span(start, end)
    },
    <start: @L> <prefix:Path> "as" <i:Ident> <end: @R> => UseTree {
        prefix,
        kind: UseTreeKind::Simple(Some(i)),
        span: ctx.span(start, end)
    },
    <start: @L> <prefix:Path> "::{" <inner_start: @L> <items:Comma<UseTreeWithId>> <inner_end: @R> "}" <end: @R> => UseTree {
        prefix,
        kind: UseTreeKind::Nested {items, span: ctx.span(inner_start, inner_end)},
        span: ctx.span(start, end)
    }
}

UseTreeWithId: (UseTree, NodeId) = <t:UseTree> => (t, ctx.id());

Separated<T, S>: Vec<T> = {
    <mut v:(<T> <S>)*> <e:T> => {
        v.into_iter().map(|e| e.0).extend_one(e).collect()
    }
}

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
}

Semi<T>: Vec<T> = {
    <mut v:(<T> ";")*> <e:T> => {
        v.push(e);
        v
    }
}

DoubleColon<T>: Vec<T> = {
    <mut v:(<T> "::")*> <e:T> => {
        v.push(e);
        v
    }
}

Path: Path = {
    <start: @L> <segments:DoubleColon<PathSegment>> <end: @R> => 
    Path {
        span: ctx.span(start, end),
        segments
    }
} 

PathSegment: PathSegment = <start: @L> <ident:Ident> <end: @R> => PathSegment { id: ctx.id(), ident, span: ctx.span(start, end) };

FunctionDecl: FunctionDecl = {
    <modifiers:FunctionModifiers> <name:Ident> "->" <sort:Sort> ";" => FunctionDecl {
        id: ctx.id(),
        modifiers,
        name,
        params: vec![],
        bind: None,
        arg_sorts: vec![],
        sort
    },
    <modifiers:FunctionModifiers> <name:Ident> "(" <arg_sorts:Comma<Sort>> ")" "->" <sort:Sort> ";" => FunctionDecl {
        id: ctx.id(),
        modifiers,
        name,
        params: vec![],
        bind: None,
        arg_sorts,
        sort
    },
    <modifiers:FunctionModifiers> <name:Ident> <bind:WhereToBind> "(" <arg_sorts:Comma<Sort>> ")" "->" <sort:Sort> ";" => FunctionDecl {
        id: ctx.id(),
        modifiers,
        name,
        params: vec![],
        bind: Some(bind),
        arg_sorts,
        sort
    },
    <modifiers:FunctionModifiers> <name:Ident> "<" <params:Comma<GenericParam>> ">" "->" <sort:Sort> ";" => FunctionDecl {
        id: ctx.id(),
        modifiers,
        name,
        params,
        bind: None,
        arg_sorts: vec![],
        sort
    },
    <modifiers:FunctionModifiers> <name:Ident> "<" <params:Comma<GenericParam>> ">" "(" <arg_sorts:Comma<Sort>> ")" "->" <sort:Sort> ";" => FunctionDecl {
        id: ctx.id(),
        modifiers,
        name,
        params,
        bind: None,
        arg_sorts,
        sort
    },
    <modifiers:FunctionModifiers> <name:Ident> "<" <params:Comma<GenericParam>> ">" <bind:WhereToBind> "(" <arg_sorts:Comma<Sort>> ")" "->" <sort:Sort> ";" => FunctionDecl {
        id: ctx.id(),
        modifiers,
        name,
        params,
        bind: Some(bind),
        arg_sorts,
        sort
    }
}

FunctionModifiers: FunctionModifiers = {
    <rigid:"\\rigid"?> <unique:"\\unique"?> <skolem:"\\skolem"?> <bound_var:"\\boundVar"?> => FunctionModifiers {
        rigid: rigid.is_some(),
        unique: unique.is_some(),
        skolem: skolem.is_some(),
        bound_var: bound_var.is_some(),
    } 
}

PredicateDecl: PredicateDecl = {
    <rigid:"\\rigid"?> <name:Ident> ";" => PredicateDecl {
        id: ctx.id(),
        rigid: rigid.is_some(),
        name,
        params: vec![],
        bind: None,
        arg_sorts: vec![]
    },
    <rigid:"\\rigid"?> <name:Ident> "(" <arg_sorts:Comma<Sort>> ")" ";" => PredicateDecl {
        id: ctx.id(),
        rigid: rigid.is_some(),
        name,
        params: vec![],
        bind: None,
        arg_sorts
    },
    <rigid:"\\rigid"?> <name:Ident> <bind:WhereToBind> "(" <arg_sorts:Comma<Sort>> ")" ";" => PredicateDecl {
        id: ctx.id(),
        rigid: rigid.is_some(),
        name,
        params: vec![],
        bind: Some(bind),
        arg_sorts,
    },
    <rigid:"\\rigid"?> <name:Ident> "<" <params:Comma<GenericParam>> ">" ";" => PredicateDecl {
        id: ctx.id(),
        rigid: rigid.is_some(),
        name,
        params,
        bind: None,
        arg_sorts: vec![],
    },
    <rigid:"\\rigid"?> <name:Ident> "<" <params:Comma<GenericParam>> ">" "(" <arg_sorts:Comma<Sort>> ")" ";" => PredicateDecl {
        id: ctx.id(),
        rigid: rigid.is_some(),
        name,
        params,
        bind: None,
        arg_sorts
    },
    <rigid:"\\rigid"?> <name:Ident> "<" <params:Comma<GenericParam>> ">" <bind:WhereToBind> "(" <arg_sorts:Comma<Sort>> ")" ";" => PredicateDecl {
        id: ctx.id(),
        rigid: rigid.is_some(),
        name,
        params,
        bind: Some(bind),
        arg_sorts
    }
}

// `{S: 0, 1}`: the operator binds a variable of sort `S` in the arguments 0 and 1.
WhereToBind: BindSpec = <start: @L> "{" <sort:Sort> ":" <nums:Comma<Int>> "}" <end: @R> => BindSpec {
    sort,
    args: nums.into_iter().map(|n| n as u8).collect(),
    span: ctx.span(start, end),
};

Sort: Sort = {
    <start: @L> <path:Path> "<" <args:Comma<GenericArg>> ">" <end: @R> => Sort {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: SortKind::Parametric(path, args)
    },
    <start: @L> <path:Path> <end: @R> => Sort {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: SortKind::Simple(path)
    },
}

// `name;`, `name<params>;`, optionally with one supersort: `nat \\extends int;`.
SortDecl: SortDecl = {
    <start: @L> <modifiers:SortModifiers> <name:Ident> <params:("<" <Comma<GenericParam>> ">")?> <extends:SortExtends?> ";" <end: @R> =>
    SortDecl {
        id: ctx.id(),
        modifiers,
        name,
        span: ctx.span(start, end),
        params: params.unwrap_or_default(),
        extends
    }
}

SortExtends: (Span, Sort) = <start: @L> "\\extends" <s:Sort> <end: @R> => (ctx.span(start, end), s);

SortModifiers: SortModifiers = {
    <formula:"\\formula"?> <meta:"\\meta"?> <top:"\\top"?> => SortModifiers {
        formula: formula.is_some(),
        top: top.is_some(),
        meta: meta.is_some()
    }
}

GenericParam: GenericParam = {
    <start: @L> "const" <name:Ident> <cstart: @L> ":" <cend: @R> <sort:Sort> <end: @R> => GenericParam {
        name,
        id: ctx.id(),
        colon_span: Some(ctx.span(cstart, cend)),
        kind: GenericParamKind::Const {
            sort,
            span: ctx.span(start, end)
        },
    },
    <name:Ident> => GenericParam {
        name, 
        id: ctx.id(),
        colon_span: None,
        kind: GenericParamKind::Sort,
    }
}

GenericArg: GenericArg = {
    <start: @L> "const" <t:Term> <end: @R> => GenericArg::Const(t, ctx.span(start, end)),
    <Sort> => GenericArg::Sort(<>)
}

Term: Term = {
    <start: @L> <p:Path> "(" <args:Comma<Term>> ")" <end: @R> => Term {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: TermKind::Call(p, args)
    },
    <start: @L> <p:Path> <end: @R> => Term {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: TermKind::Path(p)
    }
}

Rule: Rule = {
    <start: @L> <name:Ident> "{" 
        <schema_vars:SchemaVarDecl*> 
        <assumes:Assumes?>
        <find:Find?>
        <goal_specs:GoalSpecs>
        <rule_sets:RuleRuleSets?>
        <display_name:DisplayName?>
    "}" <end: @R> => Rule {
        id: ctx.id(),
        name,
        schema_vars,
        assumes,
        find,
        goal_specs,
        rule_sets,
        display_name,
        span: ctx.span(start, end)
    }
}

SchemaVarDecl: SchemaVarDecl = {
    <start: @L> "\\schemaVar" <name:Ident> ":" <sort:Sort> ";" <end: @R> => SchemaVarDecl {
        id: ctx.id(),
        span: ctx.span(start, end),
        name,
        sort
    }
}

Assumes: Spanned<TermOrSeq> = {
    <start: @L> "\\assumes" "(" <tos:TermOrSeq> ")" <end:@R> => Spanned::new(tos, ctx.span(start, end))
}

Find: Spanned<TermOrSeq> = {
    <start: @L> "\\find" "(" <tos:TermOrSeq> ")" <end:@R> => Spanned::new(tos, ctx.span(start, end))
}

GoalSpecs: GoalSpecs = {
    <start: @L> "\\closegoal" <end:@R> => GoalSpecs::CloseGoal(ctx.id(), ctx.span(start, end)),
    <start: @L> <specs:Semi<GoalSpec>> <end: @R> => GoalSpecs::Specs(specs, ctx.span(start, end))
}

GoalSpec: GoalSpec = {
    <start: @L> <name:GoalSpecName?> "\\replacewith" "(" <t:TermOrSeq> ")" <end: @R> => GoalSpec {
        id: ctx.id(),
        name,
        replace_with: Some(t),
        add: None,
        span: ctx.span(start, end)
    },
    <start: @L> <name:GoalSpecName?> "\\replacewith" "(" <r:TermOrSeq> ")" "\\add" "(" <a:TermOrSeq> ")" <end: @R> => GoalSpec {
        id: ctx.id(),
        name,
        replace_with: Some(r),
        add: Some(a),
        span: ctx.span(start, end)
    },
    <start: @L> <name:GoalSpecName?> "\\add" "(" <a:TermOrSeq> ")" <end: @R> => GoalSpec {
        id: ctx.id(),
        name,
        replace_with: None,
        add: Some(a),
        span: ctx.span(start, end)
    }
}

GoalSpecName: Ident = {
    <start: @L> <s:StringValue> ":" <end: @R> => Spanned::new(ctx.intern(&s), ctx.span(start, end))
}

CloseGoal: Span = <start: @L> "\\closegoal" <end: @R> => ctx.span(start, end);

RuleRuleSets: Spanned<Vec<RuleSetRef>> = <start: @L> "\\rulesets" "(" <rs:Comma<RuleSetRef>> ")" <end: @R> => Spanned::new(rs, ctx.span(start, end));

// A ruleset a rule belongs to, optionally instantiating the ruleset's parameters:
//   \rulesets(alpha, apply_equation(r))
RuleSetRef: RuleSetRef = {
    <p:Path> => RuleSetRef { id: ctx.id(), path: p, args: vec![] },
    <p:Path> "(" <args:Comma<Expr>> ")" => RuleSetRef { id: ctx.id(), path: p, args },
}

DisplayName: Spanned<Symbol> = <start: @L> "\\displayname" <l:StringValue> <end: @R> => Spanned::new(ctx.intern(&l), ctx.span(start, end));

TermOrSeq: TermOrSeq = {
    <ante:Comma<Term>> "==>" <succ:Comma<Term>> => TermOrSeq::Seq(Seq { id: ctx.id(), ante, succ }),
    <t:Term> => TermOrSeq::Term(t)
}

// ---------------------------------------------------------------------------
// Rulesets and costs
// ---------------------------------------------------------------------------

StringValue: String = <l:r#""[^\n"]+""#> => l[1..l.len() - 1].into();

// \rulesets { [extend|override] name[(params)] [\stage(s)] { [guard g;]* cost } }
RuleSetDecl: RuleSetDecl = {
    <start: @L> <ext:RuleSetExt?> <name:Ident> <params:RuleSetParams?> <stage:StageAssert?>
    "{" <guards:Guard*> <body:Expr> "}" <end: @R> => RuleSetDecl {
        id: ctx.id(),
        span: ctx.span(start, end),
        ext,
        name,
        params: params.unwrap_or_default(),
        stage,
        guards,
        body
    }
}

RuleSetExt: RuleSetExt = {
    "extend" => RuleSetExt::Extend,
    "override" => RuleSetExt::Override,
}

RuleSetParams: Vec<CostParam> = "(" <Comma<CostParam>> ")";

StageAssert: Ident = "\\stage" "(" <Ident> ")";

Guard: Guard = <start: @L> "guard" <p:Path> ";" <end: @R> => Guard {
    id: ctx.id(),
    span: ctx.span(start, end),
    path: p
};

// \costs { const NAME: Ty = expr; fn name(params) -> Ty { expr } }
CostItem: CostItem = {
    <start: @L> "const" <name:Ident> ":" <ty:CostTy> "=" <value:Expr> ";" <end: @R> => CostItem {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: CostItemKind::Const { name, ty, value }
    },
    <start: @L> "fn" <name:Ident> "(" <params:Comma<CostParam>> ")" "->" <ret:CostTy> "{" <body:Expr> "}" <end: @R> => CostItem {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: CostItemKind::Fn { name, params, ret, body }
    },
}

CostParam: CostParam = <start: @L> <name:Ident> ":" <ty:CostTy> <end: @R> => CostParam {
    id: ctx.id(),
    span: ctx.span(start, end),
    name,
    ty
};

// Cost, Int, Float, Bool, Op, Sort, Term<S>, ... (checked after parsing).
CostTy: CostTy = {
    <start: @L> <name:Ident> <end: @R> => CostTy {
        id: ctx.id(),
        span: ctx.span(start, end),
        name,
        arg: None
    },
    <start: @L> <name:Ident> "<" <arg:Sort> ">" <end: @R> => CostTy {
        id: ctx.id(),
        span: ctx.span(start, end),
        name,
        arg: Some(arg)
    },
}

// ---------------------------------------------------------------------------
// Cost expressions
//
// Precedence, lowest to highest:  let  <  ||  <  &&  <  comparison  <  + -  <  *  <  unary - !
// Comparison is non-associative.
// ---------------------------------------------------------------------------

pub Expr: Expr = {
    <start: @L> "let" <name:Ident> "=" <value:Expr> ";" <body:Expr> <end: @R> => Expr {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: ExprKind::Let(ctx.id(), name, Box::new(value), Box::new(body))
    },
    OrExpr,
}

OrExpr: Expr = {
    <start: @L> <a:OrExpr> "||" <b:AndExpr> <end: @R> => mk_binary(ctx.id(), ctx.span(start, end), BinOp::Or, a, b),
    AndExpr,
}

AndExpr: Expr = {
    <start: @L> <a:AndExpr> "&&" <b:CmpExpr> <end: @R> => mk_binary(ctx.id(), ctx.span(start, end), BinOp::And, a, b),
    CmpExpr,
}

CmpExpr: Expr = {
    <start: @L> <a:AddExpr> <op:CmpOp> <b:AddExpr> <end: @R> => mk_binary(ctx.id(), ctx.span(start, end), op, a, b),
    AddExpr,
}

CmpOp: BinOp = {
    "<" => BinOp::Lt,
    "<=" => BinOp::Le,
    "==" => BinOp::Eq,
    "!=" => BinOp::Ne,
    ">=" => BinOp::Ge,
    ">" => BinOp::Gt,
}

AddExpr: Expr = {
    <start: @L> <a:AddExpr> <op:AddOp> <b:MulExpr> <end: @R> => mk_binary(ctx.id(), ctx.span(start, end), op, a, b),
    MulExpr,
}

AddOp: BinOp = {
    "+" => BinOp::Add,
    "-" => BinOp::Sub,
}

MulExpr: Expr = {
    <start: @L> <a:MulExpr> "*" <b:UnaryExpr> <end: @R> => mk_binary(ctx.id(), ctx.span(start, end), BinOp::Mul, a, b),
    UnaryExpr,
}

UnaryExpr: Expr = {
    <start: @L> "-" <e:UnaryExpr> <end: @R> => mk_neg(ctx.id(), ctx.span(start, end), e),
    <start: @L> "!" <e:UnaryExpr> <end: @R> => mk_not(ctx.id(), ctx.span(start, end), e),
    AtomExpr,
}

AtomExpr: Expr = {
    <start: @L> <i:Int> <end: @R> => Expr { id: ctx.id(), span: ctx.span(start, end), kind: ExprKind::Int(i) },
    <start: @L> <f:Float> <end: @R> => Expr { id: ctx.id(), span: ctx.span(start, end), kind: ExprKind::Float(f) },
    <start: @L> "top" <end: @R> => Expr { id: ctx.id(), span: ctx.span(start, end), kind: ExprKind::Top },
    <start: @L> <p:Path> <end: @R> => Expr { id: ctx.id(), span: ctx.span(start, end), kind: ExprKind::Path(p) },
    <start: @L> <p:Path> "(" <args:Comma<CallArg>> ")" <end: @R> => Expr {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: ExprKind::Call(p, args)
    },
    <start: @L> "if" <c:Expr> "{" <a:Expr> "}" "else" "{" <b:Expr> "}" <end: @R> => Expr {
        id: ctx.id(),
        span: ctx.span(start, end),
        kind: ExprKind::If(Box::new(c), Box::new(a), Box::new(b))
    },
    "(" <Expr> ")",
}

// Either a plain argument or a binder `x in generator: body` (used by sum/any/all).
CallArg: CallArg = {
    <e:Expr> => CallArg::Expr(e),
    <start: @L> <var:Ident> "in" <generator:Expr> ":" <body:Expr> <end: @R> => CallArg::Binder(Binder {
        id: ctx.id(),
        span: ctx.span(start, end),
        var,
        generator,
        body
    }),
}

Int: i64 = <s:r"[0-9]+"> =>? i64::from_str(s)
    .map_err(|_| ParseError::User { error: "integer literal out of range" });

Float: f64 = <s:r"[0-9]+\.[0-9]+"> =>? f64::from_str(s)
    .map_err(|_| ParseError::User { error: "invalid float literal" });
